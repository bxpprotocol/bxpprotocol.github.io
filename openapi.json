          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Submit Readings",
        "description": "Accept BXP readings as JSON (SPEC.md 2) or a binary `.bxp` container\n(SPEC.md 5.1/5.2, auto-detected by magic number). The batch is stored\natomically; a reading whose ID already exists is reported, never overwritten.\n\nOwnership: an authenticated device may only submit under its own UUID, and\na UUID that belongs to a registered device can only be used with that\ndevice's token. Otherwise anyone could plant readings under (or claim the\ndeletion rights of) someone else's device.",
        "operationId": "submit_readings_bxp_v2_readings_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
