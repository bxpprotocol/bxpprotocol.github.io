    "/bxp/v2/nearby": {
      "get": {
        "summary": "Get Nearby",
        "description": "Relevance-ranked \"closest useful observation\" lookup (SPEC.md 7 Stage 6,\n8.2.1) for a caller with no sensor of their own. Ranking blends distance,\nfreshness and quality; see database.get_nearby_readings.",
        "operationId": "get_nearby_bxp_v2_nearby_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90.0,
              "minimum": -90.0,
              "title": "Lat"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180.0,
              "minimum": -180.0,
              "title": "Lon"
            }
          },
          {
            "name": "radiusM",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50000,
              "minimum": 1,
              "default": 2000,
              "title": "Radiusm"
            }
          },
          {
            "name": "maxAgeS",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 2592000,
              "minimum": 1,
              "default": 3600,
              "title": "Maxages"
            }
          },
          {
            "name": "agent",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Agent"
            }
          },
          {
            "name": "minQuality",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "UNVALIDATED",
              "title": "Minquality"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 1,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
