    "/bxp/v2/sync": {
      "get": {
        "summary": "Sync Pull",
        "description": "Federation pull (SPEC.md 7 Stage 7, 8.2.2). Returns every change after the\nopaque cursor `since` (default 0 = from the beginning), oldest first, plus\n`nextCursor` to resume from. Deleted readings arrive as tombstones\n({\"readingId\", \"deleted\": true, \"deletionProof\"}) that a replica must apply.\n\nThe cursor is the node's ingest sequence, not an observation timestamp, so\nlate-arriving readings are never skipped and a bogus far-future timestamp\ncannot stall replication. Each reading carries its originating `nodeId`.\nGated by BXP_NODE_SYNC_TOKEN when set; trust, dedup across multiple peers\nand conflict resolution are deferred (SPEC.md 7 Stage 7).",
        "operationId": "sync_pull_bxp_v2_sync_get",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Since"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 2000,
              "minimum": 1,
              "default": 500,
              "title": "Limit"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
